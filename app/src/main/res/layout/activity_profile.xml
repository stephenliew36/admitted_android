<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    >
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ll_activity_profile_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintHorizontal_bias="0"
        android:layout_margin="5dp"
        >

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_activity_profile_back"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/vd_iv_go_back" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_activity_profile_back"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="@font/raleway_bold"
            android:gravity="center"
            android:text="Roadmap"
            android:textColor="#3F5D95" />
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_activity_profile_back"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintVertical_bias="0"
        android:layout_marginTop="25dp"
        app:layout_constraintWidth_percent=".915">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_activity_profile_qrcode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_activity_profile_qrcode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    style="@style/textRalewaybold10spC4F5257"
                    android:text="My QR code  "
                    android:drawableRight="@drawable/icon_qrcode"
                    android:textColor="#3F5D95"
                    android:background="@drawable/bg_3f5d95_border"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="10dp"
                    android:layout_marginVertical="15dp"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_activity_profile_pi"
                style="@style/textRalewaybold13spC4F5257"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Account Information"
                />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                >
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_activity_profile_name"
                    style="@style/textRaleway15spC4F5257"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_activity_profile_name_input"
                    style="@style/textRalewaybold15spC4F5257"
                    android:textColor="#4F5257"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/tv_activity_profile_name"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintHorizontal_bias="1"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:src="#D6DBE3"
                android:layout_marginTop="15dp" />

            <!-- 用戶類型是「學生」時的個人資訊 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_profile_info_student"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    >
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_activity_profile_nationality"
                        style="@style/textRaleway15spC4F5257"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nationality"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_activity_profile_nationality_input"
                        style="@style/textRalewaybold15spC4F5257"
                        android:textColor="#4F5257"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/tv_activity_profile_nationality"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintHorizontal_bias="1"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:src="#D6DBE3"
                    android:layout_marginTop="15dp"
                    />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    >
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_activity_profile_School"
                        style="@style/textRaleway15spC4F5257"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="School"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_activity_profile_School_input"
                        style="@style/textRalewaybold15spC4F5257"
                        android:textColor="#4F5257"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/tv_activity_profile_School"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintHorizontal_bias="1"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:src="#D6DBE3"
                    android:layout_marginTop="15dp"
                    />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    >
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_activity_profile_year"
                        style="@style/textRaleway15spC4F5257"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Year"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_activity_profile_year_input"
                        style="@style/textRalewaybold15spC4F5257"
                        android:textColor="#4F5257"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/tv_activity_profile_year"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintHorizontal_bias="1"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:src="#D6DBE3"
                    android:layout_marginTop="15dp"
                    />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    >
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_activity_profile_schoolsystem"
                        style="@style/textRaleway15spC4F5257"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="School System"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_activity_profile_schoolsystem_input"
                        style="@style/textRalewaybold15spC4F5257"
                        android:textColor="#4F5257"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/tv_activity_profile_schoolsystem"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintHorizontal_bias="1"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:src="#D6DBE3"
                    android:layout_marginTop="15dp"
                    />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    >
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_activity_profile_gradingscal"
                        style="@style/textRaleway15spC4F5257"
                        android:layout_width="0dp"
                        app:layout_constraintWidth_percent=".3"
                        app:layout_constraintHorizontal_bias="0"
                        android:layout_height="wrap_content"
                        android:text="Grading Scale"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_activity_profile_gradingscal_input"
                        style="@style/textRalewaybold15spC4F5257"
                        android:textColor="#4F5257"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:gravity="right|center_vertical"
                        app:layout_constraintWidth_percent=".7"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/tv_activity_profile_gradingscal"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintHorizontal_bias="1"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:src="#D6DBE3"
                    android:layout_marginTop="15dp"
                    />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    >
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_activity_profile_schedule"
                        style="@style/textRaleway15spC4F5257"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Schedule"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_activity_profile_schedule_input"
                        style="@style/textRalewaybold15spC4F5257"
                        android:textColor="#4F5257"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/tv_activity_profile_schedule"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintHorizontal_bias="1"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:src="#D6DBE3"
                    android:layout_marginTop="15dp"
                    />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    >
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_activity_profile_language"
                        style="@style/textRaleway15spC4F5257"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Language Exam Requirement"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_activity_profile_language_input"
                        style="@style/textRalewaybold15spC4F5257"
                        android:textColor="#4F5257"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/tv_activity_profile_language"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintHorizontal_bias="1"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:src="#D6DBE3"
                    android:layout_marginTop="15dp"
                    />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- 用戶類型是「家長」時的個人資訊 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_profile_info_parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    >
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_activity_profile_identity"
                        style="@style/textRaleway15spC4F5257"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Identity"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_activity_profile_identity_input"
                        style="@style/textRalewaybold15spC4F5257"
                        android:textColor="#4F5257"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/tv_activity_profile_identity"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintHorizontal_bias="1"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:src="#D6DBE3"
                    android:layout_marginTop="15dp"
                    />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_activity_profile_ai"
                style="@style/textRalewaybold13spC4F5257"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Others"
                />
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:src="#D6DBE3"
                android:layout_marginTop="15dp"
                android:visibility="gone"
                />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                >
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_activity_profile_email"
                    style="@style/textRaleway15spC4F5257"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_activity_profile_email_input"
                    style="@style/textRalewaybold15spC4F5257"
                    android:textColor="#4F5257"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/tv_activity_profile_email"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintHorizontal_bias="1"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:src="#D6DBE3"
                android:layout_marginTop="15dp"
                android:visibility="gone"
                />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:visibility="gone"
                >
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_activity_profile_password"
                    style="@style/textRaleway15spC4F5257"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_activity_profile_password_input"
                    style="@style/textRalewaybold15spC4F5257"
                    android:textColor="#4F5257"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/tv_activity_profile_password"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintHorizontal_bias="1"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:src="#D6DBE3"
                android:layout_marginTop="15dp"
                />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_activity_profile_accounttype"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:visibility="gone"
                >
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_activity_profile_accounttype"
                    style="@style/textRaleway15spC4F5257"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accoun Type"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_activity_profile_accounttype_input"
                    style="@style/textRalewaybold15spC4F5257"
                    android:textColor="#4F5257"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/tv_activity_profile_accounttype"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintHorizontal_bias="1"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_activity_profile_accounttype"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:src="#D6DBE3"
                android:layout_marginTop="15dp"
                android:visibility="gone"
                />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_activity_profile_logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                >
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_activity_profile_logout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/textRalewaybold13spC4F5257"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:text="Log Out"
                    android:textColor=" #7A8899"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:src="#D6DBE3"
                android:layout_marginTop="15dp"
                android:visibility="gone"
                />
            <RelativeLayout
                android:id="@+id/rl_activity_profile_add"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_adapteritem_interest"
                android:layout_margin="25dp"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/selector_btn_default"
                    android:fontFamily="@font/raleway_bold"
                    android:lineSpacingExtra="3sp"
                    android:textAllCaps="false"
                    android:textColor="#ffffff"
                    android:textSize="14sp"
                    android:visibility="invisible" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_activity_profile_add"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:drawableRight="@drawable/vd_ic_add_white"
                    android:fontFamily="@font/raleway_bold"
                    android:gravity="center"
                    android:text="Restore Purchases"
                    android:textAllCaps="false"
                    android:textColor="#3F5D95"
                    android:textSize="13sp" />
            </RelativeLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_activity_profile_others"
                style="@style/textRalewaybold13spC4F5257"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
