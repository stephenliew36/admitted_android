<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    tools:context=".member.view.activity.LoginActivity"
    tools:ignore="RtlSymmetry">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_resetpassword_back"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/arrow_left"
        android:padding="5dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"

        app:layout_constraintWidth_percent=".064"
        app:layout_constraintHeight_percent=".052"
        app:layout_constraintVertical_bias=".02"
        app:layout_constraintHorizontal_bias=".043"

        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_resetpassword_title"
        android:text="@string/tv_resetpassword_title"
        style="@style/textPopinBold22spC4F5257"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias=".025"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.02"
        android:lineSpacingExtra="1sp"
        android:text="@string/tv_resetpassword_description"
        android:textColor="#4F5257"
        android:textSize="13sp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias=".09"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent=".95" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/et_resetpassword_email"
        style="@style/textPopin13spC4F5257"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:inputType="textEmailAddress"
        android:background="@drawable/selector_et_default"
        android:cursorVisible="true"
        android:hint="@string/et_register_email"
        android:lines="1"
        android:paddingLeft="10dp"
        android:singleLine="true"
        android:textCursorDrawable="@drawable/et_cursor"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_default="percent"

        app:layout_constraintHeight_percent=".06"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias=".15"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent=".9" />




    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_resetpassword_reset"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/vd_bg_btn_disabled"
        android:fontFamily="@font/raleway_regular"
        android:lineSpacingExtra="3sp"
        android:text="Reset Password"
        android:textAllCaps="false"
        android:textColor="#ffffff"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias=".264"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.9" />


</androidx.constraintlayout.widget.ConstraintLayout>