<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_scan_student_qrcode_back"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/arrow_left"
        android:padding="5dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"

        app:layout_constraintWidth_percent=".064"
        app:layout_constraintHeight_percent=".052"
        app:layout_constraintVertical_bias=".02"
        app:layout_constraintHorizontal_bias=".043" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_scan_student_qrcode_title"
        android:text="Add a student"
        style="@style/textPopinBold22spC4F5257"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias=".025" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_scan_student_qrcode_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Add up to 5 students by scanning a QR code"
        android:textSize="13sp"
        android:textColor="#4F5257"
        android:lineSpacingExtra="1sp"
        android:letterSpacing="0.02"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias=".09"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent=".9" />

    <com.journeyapps.barcodescanner.BarcodeView
        android:id="@+id/barcode_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_scan_student_qrcode_subtitle"
        android:layout_marginTop="20dp"
        android:background="@color/black"
        app:zxing_preview_scaling_strategy="fitCenter"
        app:zxing_use_texture_view="true" />

    <com.realtouchapp.tools.customview.QrcodeOverlayView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@+id/barcode_view"
        app:layout_constraintBottom_toBottomOf="@+id/barcode_view"
        app:layout_constraintLeft_toLeftOf="@+id/barcode_view"
        app:layout_constraintRight_toRightOf="@+id/barcode_view"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_photo_library"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="35dp"
        android:paddingHorizontal="15dp"
        android:background="@drawable/bg_white_border">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_photo_library"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:gravity="center"
            android:text="Photo library"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:lineSpacingExtra="1sp"
            android:letterSpacing="0.02"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_photo_library"
            android:layout_marginEnd="5dp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_photo_library"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_photo_library"
            app:layout_constraintDimensionRatio="1:1"
            android:layout_marginVertical="10dp"
            android:src="@drawable/ic_photo_library"
            android:contentDescription="@null"
            android:scaleType="fitCenter"/>
        
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_manual_enter_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/barcode_view"
        app:layout_constraintLeft_toLeftOf="@id/barcode_view"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="5dp"
        android:text="Manual"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp" />

</androidx.constraintlayout.widget.ConstraintLayout>