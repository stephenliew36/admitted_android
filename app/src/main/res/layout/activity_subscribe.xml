<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    tools:context=".begin.view.BeginActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/vd_ic_subscribe"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_subscribe_back"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintWidth_percent=".1"
            android:src="@drawable/vd_ic_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias=".95"
            app:layout_constraintVertical_bias=".05"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <TextView
        android:id="@+id/tv_begin_weclome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:lineSpacingExtra="-3sp"
        android:text="Choose a plan to coninue"
        android:textSize="22sp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_activity_subscribe_monthly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="25dp"
        app:cardCornerRadius="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F2F4F6">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_activity_subscribe_monthly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginLeft="15dp"
                android:button="@drawable/selector_cb_circle"
                android:buttonTint="#3F5D95"
                android:clickable="false"

                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_activity_subscribe_monthly_title"
                style="@style/textRalewaybold15spC4F5257"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginTop="15dp"
                android:layout_toRightOf="@+id/cb_activity_subscribe_monthly"
                android:text="$8.99 / Month" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_activity_subscribe_monthly_content"
                style="@style/textRaleway10spC4F5257"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_activity_subscribe_monthly_title"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="15dp"
                android:layout_toRightOf="@+id/cb_activity_subscribe_monthly"
                android:text="You will be charged $8.99 after 7 days. Billed monthly" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_activity_subscribe_quarter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="25dp"
        app:cardCornerRadius="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F2F4F6">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_activity_subscribe_quarter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginLeft="15dp"
                android:button="@drawable/selector_cb_circle"
                android:buttonTint="#3F5D95"
                android:clickable="false"

                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_activity_subscribe_quarter_title"
                style="@style/textRalewaybold15spC4F5257"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginTop="15dp"
                android:layout_toRightOf="@+id/cb_activity_subscribe_quarter"
                android:text="$19.99 / Quarter" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_activity_subscribe_quarter_content"
                style="@style/textRaleway10spC4F5257"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_activity_subscribe_quarter_title"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="15dp"
                android:layout_toRightOf="@+id/cb_activity_subscribe_quarter"
                android:text="You will be charged 19.99 after 14 days. Billed every 3 months" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_activity_subscribe_year"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="25dp"
        app:cardCornerRadius="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F2F4F6">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_activity_subscribe_monthly_popular"
                style="@style/textRalewaybold10spC4F5257"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"
                android:background="@drawable/bg_circle_part"
                android:padding="10dp"
                android:text="Most popular"

                />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_activity_subscribe_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginLeft="15dp"
                android:button="@drawable/selector_cb_circle"
                android:buttonTint="#3F5D95"
                android:clickable="false" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_activity_subscribe_year_title"
                style="@style/textRalewaybold15spC4F5257"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginTop="15dp"
                android:layout_toRightOf="@+id/cb_activity_subscribe_year"
                android:text="$49.99 / Year" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_activity_subscribe_year_content"
                style="@style/textRaleway10spC4F5257"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_activity_subscribe_year_title"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="15dp"
                android:layout_toRightOf="@+id/cb_activity_subscribe_year"
                android:text="You will be charged $49.99 after 1 month. Billed annually" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_begin_create"
        style="@style/textRaleway10spC4F5257"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:text="Auto-renewable. Cancel anytime in the Play Store." />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_begin_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:background="@drawable/vd_bg_btn_disabled"
        android:fontFamily="@font/raleway_regular"
        android:gravity="center"
        android:lineSpacingExtra="3sp"
        android:text="Continue"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_begin_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/raleway_regular"
        android:gravity="center_horizontal|top"
        android:lineSpacingExtra="3sp"
        android:text="@string/get_started"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:translationY="-1.47sp"

        app:layout_constraintBottom_toBottomOf="@+id/btn_begin_start"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_begin_start"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.85"

        />

</androidx.appcompat.widget.LinearLayoutCompat>