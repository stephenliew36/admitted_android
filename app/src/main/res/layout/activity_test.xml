<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    tools:context=".begin.view.SplashActivity">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/ns"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent=".62"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        >
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                >

            </androidx.appcompat.widget.AppCompatTextView>
        </androidx.appcompat.widget.LinearLayoutCompat>
        
    </androidx.core.widget.NestedScrollView>
    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/et_id"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ns"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintHorizontal_bias="0"
        ></androidx.appcompat.widget.AppCompatEditText>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent=".3"
        app:layout_constraintVertical_bias="1"
        >
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                >
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_titile_usertargetschool"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="目標學校"
                    android:background="@null"
                    />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_post_targetschool"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="postList"
                    />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_put_targetschool"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="putList"
                    />


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_get_targetschool"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="get"
                    />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_deletelist_targetschool"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="deletelist"
                    />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                >
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_post_targetschool_id"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="postID"
                    />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_delete_targetschool_id"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="DELETEID"
                    />


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_cache_usertargetschool"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="cache"
                    />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                >
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_titile_application"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="申請學校"
                    android:background="@null"
                    />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_post_application"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="post"
                    />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_put_application"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="put"
                    />


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_get_application"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="get"
                    />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_cache_application"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="cache"
                    />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                >
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_titile_targetschool"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="學校簡章"
                    android:background="@null"
                    />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_get_targetschool_brief"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="Brief"
                    />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_get_targetschool_deatil"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="Detail"
                    />


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_get_targetschool_id"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="getID"
                    />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_cache_targetschool"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="cache"
                    />

            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                >
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_titile_userinfo"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="用戶資料"
                    android:background="@null"
                    />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_put_userinfo"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="put"
                    />


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_get_userinfo"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="get"
                    />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_cache_userinfo"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="cache"
                    />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                >
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_titile"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="post"
                    />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_post"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="post"
                    />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_put"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="put"
                    />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_delete"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="delete"
                    />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_get"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="get"
                     />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_cache"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="cache"
                     />
            </androidx.appcompat.widget.LinearLayoutCompat>
            
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="login"
                    />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_cachetoken"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="wrap_content"
                    android:text="getToken"
                    />
            </androidx.appcompat.widget.LinearLayoutCompat>


            
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
    

   

</androidx.constraintlayout.widget.ConstraintLayout>