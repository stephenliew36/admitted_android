<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ll_mainacivity_ap"
        android:layout_width="132dp"
        android:layout_height="160dp"
        android:layout_centerHorizontal="true"
        android:background="@drawable/bg_frame_f2f4f6"
        android:gravity="center_horizontal|bottom"
        android:orientation="vertical"
        android:layout_margin="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_adapter_date_ttile"
            style="@style/textRaleway10spC4F5257"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="10sp"
            android:text="Restrictive Early Action" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_adapter_date"
            style="@style/textRalewaybold13spC4F5257"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="20sp"
            android:text="10 \nNonember"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_margin="10dp"
            android:background="#D6DBE3" />
        <RelativeLayout
            android:id="@+id/rl_adapter_date_add"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="?android:attr/selectableItemBackground"
            >
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_adapter_date_add"
                style="@style/textRalewaybold10spC4F5257"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:drawableRight="@drawable/vd_ic_add"
                android:gravity="center"
                android:textColor="#3F5D95"
                android:text="Set Calendar\t " />
        </RelativeLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>