<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:ignore="MissingDefaultResource,RtlSymmetry">
    <View
        android:layout_width="match_parent"
        android:layout_height="8dp"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_adapter_recycleview_title"
        style="@style/textRalewaybold15spC4F5257"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Volunteer, One Nursing Home"
        android:layout_marginBottom="5dp"
        />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_adapter_recycleview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/vd_ct_cs"
        />


</androidx.appcompat.widget.LinearLayoutCompat>