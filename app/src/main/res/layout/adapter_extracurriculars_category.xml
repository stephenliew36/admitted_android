<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_margin="5dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_adapter_extracurricularsmain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_adapter_extracurricularsmain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/textRalewaybold13spC4F5257"
            app:layout_constraintBottom_toTopOf="@+id/rv_adapter_extracurricularsmain"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias="0"
            android:text="Extracurriculars Near You"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_adapter_extracurricularsmain_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/textRaleway_regular13spC4F5257"
            app:layout_constraintBottom_toTopOf="@+id/rv_adapter_extracurricularsmain"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:text="View All"
            app:layout_constraintHorizontal_bias="1"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_adapter_extracurricularsmain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_adapter_extracurricularsmain"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.appcompat.widget.LinearLayoutCompat>