<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp"
    >

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_adapter_recycleview_title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        style="@style/textPopin13spC4F5257"
        android:background="@drawable/bg_adapteritem_interest"
        android:text="Math"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent=".062"
        android:paddingLeft="10dp"
        app:layout_constraintVertical_bias="1"
        />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_adapter_recycleview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/vd_ic_close"
        app:layout_constraintBottom_toBottomOf="@+id/tv_adapter_recycleview_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_adapter_recycleview_title"
        app:layout_constraintHorizontal_bias=".965"
        >

    </androidx.appcompat.widget.AppCompatImageView>

</androidx.constraintlayout.widget.ConstraintLayout>