<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:background="@android:color/transparent"
    tools:ignore="RtlSymmetry"
    >

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ll_bsdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_bsdf_addtest_divider"
            android:layout_width="100dp"
            android:layout_height="2dp"
            android:src="#BDBDBD" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_bsdf_addtest_title"
            style="@style/textRalewaybold17spC4F5257"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/tv_bsdf_addtest_add" />
        
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_bsdf_addtest_name"
            style="@style/textRalewaybold13spC4F5257"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tv_bsdf_addtest_name" />

        <RelativeLayout
            android:id="@+id/rl_bsdf_addtest_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <androidx.appcompat.widget.AppCompatSpinner
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:id="@+id/sp_bsdf_addtest_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignLeft="@+id/et_bsdf_addtest_name"
                android:layout_alignTop="@+id/et_bsdf_addtest_name"
                android:layout_alignRight="@+id/et_bsdf_addtest_name"
                android:layout_alignBottom="@+id/et_bsdf_addtest_name"
                android:spinnerMode="dropdown" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/et_bsdf_addtest_name"
                style="@style/textRaleway_regular13spC4F5257"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:background="@drawable/selector_et_default"
                android:cursorVisible="true"
                android:hint="@string/et_bsdf_addtest_name_hint"
                android:lines="1"
                android:paddingLeft="10dp"
                android:paddingRight="30dp"
                android:singleLine="true"
                android:textColorHint="#BDBDBD"
                />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_bsdf_addtest_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/et_bsdf_addtest_name"
                android:layout_alignBottom="@+id/et_bsdf_addtest_name"
                android:layout_alignParentRight="true"
                android:layout_marginRight="10dp"
                android:src="@drawable/vd_ic_arrow_dwon_black" />
        </RelativeLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_bsdf_addtest_apsubject"
            style="@style/textRalewaybold13spC4F5257"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tv_bsdf_addtest_apsubject"
            android:visibility="gone"/>

        <RelativeLayout
            android:id="@+id/rl_bsdf_addtest_apsubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatSpinner
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:id="@+id/sp_bsdf_addtest_apsubject"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignLeft="@+id/et_bsdf_addtest_apsubject"
                android:layout_alignTop="@+id/et_bsdf_addtest_apsubject"
                android:layout_alignRight="@+id/et_bsdf_addtest_apsubject"
                android:layout_alignBottom="@+id/et_bsdf_addtest_apsubject"
                android:spinnerMode="dropdown" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/et_bsdf_addtest_apsubject"
                style="@style/textRaleway_regular13spC4F5257"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:background="@drawable/selector_et_default"
                android:cursorVisible="true"
                android:hint="@string/et_bsdf_addtest_apsubject_hint"
                android:lines="1"
                android:paddingLeft="10dp"
                android:paddingRight="30dp"
                android:singleLine="true"
                android:textColorHint="#BDBDBD"
                />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_bsdf_addtest_apsubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/et_bsdf_addtest_apsubject"
                android:layout_alignBottom="@+id/et_bsdf_addtest_apsubject"
                android:layout_alignParentRight="true"
                android:layout_marginRight="10dp"
                android:src="@drawable/vd_ic_arrow_dwon_black" />
        </RelativeLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_bsdf_addtest_date"
            style="@style/textRalewaybold13spC4F5257"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tv_bsdf_addtest_date" />
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
            <RelativeLayout
                android:id="@+id/rl_bsdf_addtest_date_month"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="20dp">

                <androidx.appcompat.widget.AppCompatSpinner
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:id="@+id/sp_bsdf_addtest_date_month"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignLeft="@+id/et_bsdf_addtest_date_month"
                    android:layout_alignTop="@+id/et_bsdf_addtest_date_month"
                    android:layout_alignRight="@+id/et_bsdf_addtest_date_month"
                    android:layout_alignBottom="@+id/et_bsdf_addtest_date_month"
                    android:spinnerMode="dropdown"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/et_bsdf_addtest_date_month"
                    style="@style/textRaleway_regular13spC4F5257"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/selector_et_default"
                    android:cursorVisible="true"
                    android:hint="@string/et_bsdf_addtest_date_month_hint"
                    android:lines="1"
                    android:paddingLeft="10dp"
                    android:paddingRight="30dp"
                    android:singleLine="true"
                    android:textColorHint="#BDBDBD"
                    />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_bsdf_addtest_date_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/et_bsdf_addtest_date_month"
                    android:layout_alignBottom="@+id/et_bsdf_addtest_date_month"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="10dp"
                    android:src="@drawable/vd_ic_arrow_dwon_black" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_bsdf_addtest_date_year"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="2">

                <androidx.appcompat.widget.AppCompatSpinner
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:id="@+id/sp_bsdf_addtest_date_year"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignLeft="@+id/et_bsdf_addtest_date_year"
                    android:layout_alignTop="@+id/et_bsdf_addtest_date_year"
                    android:layout_alignRight="@+id/et_bsdf_addtest_date_year"
                    android:layout_alignBottom="@+id/et_bsdf_addtest_date_year"
                    android:spinnerMode="dropdown"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/et_bsdf_addtest_date_year"
                    style="@style/textRaleway_regular13spC4F5257"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/selector_et_default"
                    android:cursorVisible="true"
                    android:hint="@string/et_bsdf_addtest_date_year_hint"
                    android:lines="1"
                    android:paddingLeft="10dp"
                    android:paddingRight="30dp"
                    android:singleLine="true"
                    android:textColorHint="#BDBDBD"
                    />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_bsdf_addtest_date_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/et_bsdf_addtest_date_year"
                    android:layout_alignBottom="@+id/et_bsdf_addtest_date_year"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="10dp"
                    android:src="@drawable/vd_ic_arrow_dwon_black" />
            </RelativeLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
       
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_bsdf_addtest_score"
            style="@style/textRalewaybold13spC4F5257"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tv_bsdf_addtest_score" />

        <RelativeLayout
            android:id="@+id/rl_bsdf_addtest_score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatSpinner
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:id="@+id/sp_bsdf_addtest_score"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignLeft="@+id/et_bsdf_addtest_score"
                android:layout_alignTop="@+id/et_bsdf_addtest_score"
                android:layout_alignRight="@+id/et_bsdf_addtest_score"
                android:layout_alignBottom="@+id/et_bsdf_addtest_score"
                android:spinnerMode="dropdown" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/et_bsdf_addtest_score"
                style="@style/textRaleway_regular13spC4F5257"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:background="@drawable/selector_et_default"
                android:cursorVisible="true"
                android:hint="Select from the  following options"
                android:lines="1"
                android:paddingLeft="10dp"
                android:paddingRight="30dp"
                android:singleLine="true"
                android:textColorHint="#BDBDBD"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/et_bsdf_addtest_score_max"
                style="@style/textRaleway_regular13spC4F5257"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:gravity="right|center_vertical"
                android:cursorVisible="true"
                android:hint="@string/et_bsdf_addtest_score_max_hint_sat"
                android:lines="1"
                android:singleLine="true"
                android:textColorHint="#BDBDBD"
                android:paddingRight="10dp"
                android:layout_alignTop="@+id/et_bsdf_addtest_score"
                android:layout_alignBottom="@+id/et_bsdf_addtest_score"
                android:layout_alignParentRight="true"
                android:layout_marginRight="10dp"
                 />

        </RelativeLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_bsdf_addtest_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/selector_btn_default"
            android:fontFamily="@font/raleway_regular"
            android:lineSpacingExtra="3sp"
            android:text="@string/btn_bsdf_school_done"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textSize="14sp" />
    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.constraintlayout.widget.ConstraintLayout>