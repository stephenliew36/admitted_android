<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:background="@android:color/transparent"
    tools:ignore="RtlSymmetry"
    >

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ll_bsdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_bsdf_attention_divider"
            android:layout_width="100dp"
            android:layout_height="2dp"
            android:src="#BDBDBD" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_bsdf_attention_title"
            style="@style/textRalewaybold17spC4F5257"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#D9445F"
            android:text="@string/tv_bsdf_attention_title" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_bsdf_attention_name"
            style="@style/textRaleway15spC4F5257"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tv_bsdf_attention_name" />

        

            
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_bsdf_attention_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/selector_btn_default"
            android:fontFamily="@font/raleway_regular"
            android:lineSpacingExtra="3sp"
            android:text="@string/btn_bsdf_attention_cancel"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textSize="14sp" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_bsdf_attention_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:fontFamily="@font/raleway_bold"
            android:lineSpacingExtra="3sp"
            android:text="@string/btn_bsdf_attention_delete"
            android:textAllCaps="false"
            android:textColor="#D9445F"
            android:textSize="14sp" />
    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.constraintlayout.widget.ConstraintLayout>