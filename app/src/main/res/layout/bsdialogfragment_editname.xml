<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:background="@android:color/transparent"
    tools:ignore="RtlSymmetry">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ll_bsdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_bsdf_editname_divider"
            android:layout_width="100dp"
            android:layout_height="2dp"
            android:src="#BDBDBD" />
        <RelativeLayout
            android:id="@+id/rl_bsdf_editname_first"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_bsdf_editname_first"
                style="@style/textPopin13spC4F5257"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:background="@drawable/selector_et_default"
                android:cursorVisible="true"
                android:hint="@string/et_bsdf_editname_first_hint"
                android:textColorHint="#BDBDBD"
                android:lines="1"
                android:paddingLeft="10dp"
                android:singleLine="true"
                android:textCursorDrawable="@drawable/et_cursor" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_bsdf_editname_first_remove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/et_bsdf_editname_first"
                android:layout_alignBottom="@+id/et_bsdf_editname_first"
                android:layout_alignParentRight="true"
                android:layout_marginRight="10dp"
                android:src="@drawable/vd_ic_close"
                android:visibility="invisible"/>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_bsdf_editname_last"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_bsdf_editname_last"
                style="@style/textPopin13spC4F5257"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:background="@drawable/selector_et_default"
                android:cursorVisible="true"
                android:hint="@string/et_bsdf_editname_last_hint"
                android:textColorHint="#BDBDBD"
                android:lines="1"
                android:paddingLeft="10dp"
                android:paddingRight="30dp"
                android:singleLine="true"
                android:textCursorDrawable="@drawable/et_cursor" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_bsdf_editname_last_remove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/et_bsdf_editname_last"
                android:layout_alignBottom="@+id/et_bsdf_editname_last"
                android:layout_alignParentRight="true"
                android:layout_marginRight="10dp"
                android:src="@drawable/vd_ic_close"
                android:visibility="invisible"/>
        </RelativeLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_bsdf_editname_save"
            style="@style/textRalewaybold13spC4F5257"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/vd_bg_btn_disabled"
            android:gravity="center"
            android:text="@string/btn_bsdf_editname_save"
            android:textAllCaps="false"
            android:textColor="#ffffff" />
    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.constraintlayout.widget.ConstraintLayout>