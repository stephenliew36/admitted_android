<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:background="@android:color/transparent"
    >
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_bsdf_interset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_gravity="center_horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            >
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_bsdf_interset_divider"
                android:layout_width="100dp"
                android:layout_height="2dp"
                android:src="#BDBDBD"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_bsdf_interset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_bsdf_interset_done"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_btn_default"
                android:fontFamily="@font/raleway_regular"
                android:lineSpacingExtra="3sp"
                android:text="@string/btn_bsdf_interset_done"
                android:textAllCaps="false"
                android:textColor="#ffffff"
                android:textSize="14sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.constraintlayout.widget.ConstraintLayout>