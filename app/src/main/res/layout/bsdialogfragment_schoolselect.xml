<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:background="@android:color/transparent">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ll_bsdf_school"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_bsdf_school_divider"
            android:layout_width="100dp"
            android:layout_height="2dp"
            android:src="#BDBDBD" />

        <RelativeLayout
            android:id="@+id/rl_bsdf_school"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_bsdf_school"
                style="@style/textPopin13spC4F5257"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:background="@drawable/selector_et_default"
                android:cursorVisible="true"
                android:hint="@string/et_bsdf_school_hint"
                android:textColorHint="#BDBDBD"
                android:lines="1"
                android:paddingLeft="30dp"
                android:paddingRight="30dp"
                android:singleLine="true"
                android:textCursorDrawable="@drawable/et_cursor" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_bsdf_school_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/et_bsdf_school"
                android:layout_alignBottom="@+id/et_bsdf_school"
                android:layout_alignParentLeft="true"
                android:layout_marginLeft="10dp"
                android:src="@drawable/vd_ic_search"
                />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_bsdf_school_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/et_bsdf_school"
                android:layout_alignBottom="@+id/et_bsdf_school"
                android:layout_alignParentRight="true"
                android:layout_marginRight="10dp"
                android:src="@drawable/vd_ic_close"
                android:visibility="invisible"/>
        </RelativeLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="left|center_vertical"
            android:layout_margin="5dp"
            android:background="@drawable/selector_et_default"
            android:orientation="horizontal">

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_bsdf_school"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_bsdf_school_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/selector_btn_default"
            android:fontFamily="@font/raleway_regular"
            android:lineSpacingExtra="3sp"
            android:text="@string/btn_bsdf_school_done"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textSize="14sp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.constraintlayout.widget.ConstraintLayout>