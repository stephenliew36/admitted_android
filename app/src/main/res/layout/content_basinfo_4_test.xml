<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="RtlSymmetry">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_basicinfo4_descrip"
        style="@style/textPopin10spC4F5257"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="@string/tv_basicinfo4_descrip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent=".02"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias=".066"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent=".95" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_basicinfo4_title"
        style="@style/textPopinBold22spC4F5257"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="@string/tv_basicinfo4_title"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.12"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent=".95" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent=".8"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="1dp"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent=".91">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_basicinfo4_addinterest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            </androidx.recyclerview.widget.RecyclerView>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_basicinfo4_addtest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_frame_add_dash"
                android:fontFamily="@font/poppins_regular"
                android:text="@string/btn_basicinfo4_addtest"
                android:lineSpacingExtra="3sp"
                android:padding="5dp"
                android:textAllCaps="false"
                android:textColor="#BDBDBD"
                android:textSize="14sp" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_basicinfo4_descrip2"
                style="@style/textPopin13spC7A8899"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/tv_basicinfo4_descrip2"
                />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_basicinfo4_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/vd_bg_btn_disabled"
                android:fontFamily="@font/raleway_regular"
                android:lineSpacingExtra="3sp"
                android:text="@string/btn_basicinfo2_next"
                android:textAllCaps="false"
                android:textColor="#ffffff"
                android:textSize="14sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_basicinfo4_skip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_btn_default"
                android:fontFamily="@font/raleway_regular"
                android:lineSpacingExtra="3sp"
                android:text="@string/btn_basicinfo3_skip"
                android:textAllCaps="false"
                android:textColor="#ffffff"
                android:textSize="14sp" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>