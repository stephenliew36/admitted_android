<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3F5D95"
    android:orientation="vertical"
    android:gravity="center|bottom">
    <View
        android:layout_width="match_parent"
        android:layout_height="300dp"
        app:layout_constraintBottom_toTopOf="@+id/iv_qucikadd_close"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        />


    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="550dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintVertical_bias=".9"

        >
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="25dp"
            >
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_qucikadd_gpa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                >
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/bg_circle_d6dbe3"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/vd_ic_gpa" />
                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/textRalewaybold13spC4F5257"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#ffffff"
                    android:text="GPA"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_qucikadd_ic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                >
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/bg_circle_d6dbe3"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/vd_ic_intellectual_interests" />
                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/textRalewaybold13spC4F5257"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#ffffff"
                    android:text="Intellectual\nCuriosity"
                    android:gravity="center"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_qucikadd_honors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                >
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/bg_circle_d6dbe3"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/vd_ic_honors" />
                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/textRalewaybold13spC4F5257"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#ffffff"
                    android:text="Honors &amp;\nAwards"
                    android:gravity="center"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    />
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="25dp"
            >
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_qucikadd_course"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                >
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/bg_circle_d6dbe3"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/vd_ic_academics" />
                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/textRalewaybold13spC4F5257"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#ffffff"
                    android:text="Academic \nPerformance"
                    android:gravity="center"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_qucikadd_ci"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                >
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/bg_circle_d6dbe3"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/vd_ic_community_imapct" />
                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/textRalewaybold13spC4F5257"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#ffffff"
                    android:text="Community\nImpact"
                    android:gravity="center"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_qucikadd_test"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                >
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/bg_circle_d6dbe3"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/vd_ic_tests" />
                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/textRalewaybold13spC4F5257"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#ffffff"
                    android:text="Standardized\nTests"
                    android:gravity="center"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    />
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_qucikadd_close"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@drawable/vd_ic_close"
        android:layout_marginBottom="25dp"
        />
</androidx.appcompat.widget.LinearLayoutCompat>