<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/clExploreFreeUpgrade"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent=".935"
        android:layout_marginTop="16dp"
        >
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_targetschool"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/vd_ic_search"
            style="@style/textRaleway_regular13spC4F5257"
            android:textColor="#4F5257"
            android:textColorHint="#BDBDBD"
            android:paddingLeft="15dp"
            android:drawablePadding="10dp"
            android:hint="Search Colleges"
            android:background="@drawable/bg_frame_f2f4f6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintHorizontal_bias="0"
            />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_targetschool_filter"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_default="percent"
            app:layout_constraintWidth_percent=".093"
            android:src="@drawable/vd_ic_filter"
            android:contentDescription="@string/explore_filter_accessibility"
            android:minWidth="48dp"
            android:minHeight="48dp"
            app:layout_constraintLeft_toRightOf="@+id/et_targetschool"
            app:layout_constraintBottom_toBottomOf="@+id/et_targetschool"
            app:layout_constraintRight_toLeftOf="@+id/iv_targetschool_fav"
            app:layout_constraintTop_toTopOf="@+id/et_targetschool"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_targetschool_fav"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_default="percent"
            app:layout_constraintWidth_percent=".093"
            android:src="@drawable/vd_ic_favorite"
            android:contentDescription="@string/explore_saved_accessibility"
            android:minWidth="48dp"
            android:minHeight="48dp"
            app:layout_constraintBottom_toBottomOf="@+id/et_targetschool"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/et_targetschool"
            app:layout_constraintHorizontal_bias="1"/>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_targetschool"
            app:layout_constraintVertical_bias="0"
            android:layout_marginTop="16dp"
            >
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingBottom="50dp"
                >
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_fragment_targetschool"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="15dp"
                    >

                </androidx.recyclerview.widget.RecyclerView>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_mainacivity_free_example_explore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/pic_free_example_explore"
                    android:scaleType="fitStart"
                    android:visibility="gone"
                    />
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:visibility="gone"
        android:id="@+id/clExploreFreeUpgrade"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/bg_corner_3f5d95"
        android:layout_margin="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias=".975"
        android:foreground="?attr/selectableItemBackground"
        >
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/vd_details"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias=".95"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upgrade to Premium"
            android:textColor="@android:color/white"
            style="@style/textRalewaybold15spC4F5257"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias=".5"
            app:layout_constraintVertical_bias=".2"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintWidth_percent=".55"
            android:text="Learn about your target, reach, and safety schools"
            android:textColor="@android:color/white"
            style="@style/textRaleway15spC4F5257"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias=".525"
            app:layout_constraintVertical_bias=".7"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/vd_aplus"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias=".015"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
